{
  "name": "solar-pseo-calc-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Solar pSEO platform - calculation engine, page generator, and build-time verification.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/calc-engine/*.test.ts src/pseo/*.test.ts",
    "build": "node --experimental-strip-types src/pseo/generate.ts",
    "verify": "node --experimental-strip-types src/pseo/verify.ts",
    "ai:generate": "node --experimental-strip-types src/pseo/generate-ai-content.ts",
    "ai:plan": "node --experimental-strip-types src/pseo/generate-ai-content.ts --dry-run",
    "data:import": "node --experimental-strip-types src/pseo/import-csv.ts",
    "build:verified": "npm run typecheck && npm run test && npm run build && npm run verify"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@google/genai": "^2.23.0",
    "@types/node": "^22.20.3",
    "@types/papaparse": "^5.5.2",
    "papaparse": "^5.7.0",
    "typescript": "^7.0.2"
  }
}
